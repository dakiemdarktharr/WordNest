{
  "name": "wordnest",
  "version": "0.3.2",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "vite preview --host 127.0.0.1",
    "lint": "oxlint",
    "format": "oxfmt",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "icon:build": "node scripts/build-icon.mjs",
    "desktop:prepare": "npm run build && node scripts/prepare-desktop.mjs",
    "desktop": "npm run desktop:prepare && electron desktop-app",
    "desktop:pack": "npm run desktop:prepare && electron-builder --projectDir desktop-app --config ../electron-builder.config.mjs --dir --win",
    "desktop:dist": "npm run desktop:prepare && electron-builder --projectDir desktop-app --config ../electron-builder.config.mjs --win",
    "test:desktop": "node scripts/desktop-smoke.mjs",
    "test:security": "node --test tests/*.test.mjs",
    "test:journey": "node scripts/journey-check.mjs",
    "measure": "node --experimental-strip-types scripts/measure.mjs",
    "desktop:dist:mac": "npm run desktop:prepare && electron-builder --projectDir desktop-app --config ../electron-builder.config.mjs --mac dmg zip --publish never",
    "test:mac": "node scripts/macos-package-check.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "^19.2.8",
    "react-day-picker": "9.8.1",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "4.5.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "sharp": "0.35.4",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "^8.2.2"
  },
  "type": "module",
  "description": "WordNest — offline-first vocabulary learning with spaced repetition",
  "author": "WordNest",
  "main": "desktop/main.mjs"
}
